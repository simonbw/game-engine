{
  "name": "game-engine",
  "version": "1.0.0",
  "productName": "Game Engine",
  "description": "My starter project for making lots of games",
  "main": ".vite/build/main.cjs",
  "scripts": {
    "start": "concurrently -n assets,server \"npm run watch-manifest\" \"npm run dev-server\"",
    "dev-server": "vite",
    "watch-manifest": "tsx ./bin/generate-manifest.ts watch",
    "build": "vite build",
    "preview": "vite preview",
    "tsc": "tsc --noEmit",
    "tsc-watch": "tsc --noEmit --watch",
    "prettier": "prettier --write src bin tests vite-plugins",
    "generate-manifest": "tsx ./bin/generate-manifest.ts",
    "test": "npm run test:unit && playwright test",
    "test:unit": "tsx --test \"tests/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "docs": "typedoc",
    "profile-game": "tsx ./bin/profile-game.ts",
    "clip": "tsx ./bin/record-clip.ts",
    "electron": "electron-forge start --",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "test:electron": "electron-forge package && playwright test --config tests/electron/playwright.config.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simonbw/game-engine.git"
  },
  "author": "",
  "license": "UNLICENSED",
  "homepage": "https://github.com/simonbw/game-engine#readme",
  "dependencies": {
    "@picocss/pico": "^2.1.1",
    "pixi.js": "^8.21.0",
    "poly-decomp-es": "^0.4.2",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron-forge/shared-types": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.2",
    "camelcase": "^9.0.0",
    "chokidar": "^5.0.0",
    "concurrently": "^10.0.5",
    "electron": "^44.9.3",
    "ffmpeg-static": "^5.3.0",
    "glob": "^13.0.6",
    "prettier": "^3.9.8",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "vite": "^8.3.4"
  }
}
